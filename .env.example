# TfL Open Data API key (required)
FLATHUNT__TFL_API_KEY=your_tfl_api_key_here

# JSON array of commute destinations: [[lon, lat, max_minutes], ...]
FLATHUNT__QUERIES=[[-0.1299217, 51.5194938, 25]]

# GitHub personal access token with models:read scope (required for LLM extraction)
GITHUB_TOKEN=your_github_token_here

# Path to OSM shapefile (optional, default shown)
# FLATHUNT_ROADS_FILE_PATH=greater-london-251126-free/gis_osm_roads_free_1.shp

# Dagster run schedule in cron format (optional, default: 10pm daily)
# FLATHUNT__DAILY_CRON=0 22 * * *

# SMTP email notifications (all required if any are set)
# FLATHUNT__SMTP_HOST=smtp.gmail.com
# FLATHUNT__SMTP_PORT=587
# FLATHUNT__SMTP_USERNAME=you@gmail.com
# FLATHUNT__SMTP_PASSWORD=your_app_password
# FLATHUNT__SMTP_FROM=you@gmail.com
# FLATHUNT__SMTP_TO=recipient@gmail.com

# Streamlit server config (optional)
# FLATHUNT__STREAMLIT_HOST=localhost
# FLATHUNT__STREAMLIT_PORT=8501

# Disable GIL for Streamlit (Python 3.14t free-threaded only)
# PYTHON_GIL=0
